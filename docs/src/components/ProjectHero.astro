---
import { Image } from 'astro:assets';
import { LinkButton } from '@astrojs/starlight/components';
import DefaultHero from '@astrojs/starlight/components/Hero.astro';

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, image, actions = [] } = data.hero || {};
const screenshot = image && 'file' in image ? image.file : undefined;
---

{screenshot ? (
	<section class="project-hero">
		<div>
			<h1 id="_top" data-page-title set:html={title} />
			{tagline && <p class="tagline" set:html={tagline} />}
			<div class="actions">
				{actions.map(({ link, text, icon, variant, attrs }) => (
					<LinkButton href={link} icon={icon?.name} variant={variant} {...attrs}>{text}</LinkButton>
				))}
			</div>
		</div>
		<a class="hero-preview" href="/use/gallery/" aria-label="Explore the interface gallery">
			<Image src={screenshot} width={screenshot.width} height={screenshot.height} alt={image?.alt || 'The touchscreen app launcher'} loading="eager" />
			<span>Apps, dashboards and appearance options <span aria-hidden="true">→</span></span>
		</a>
	</section>
) : <DefaultHero />}

<style>
	.project-hero {
		display: grid;
		gap: 2rem;
		align-items: center;
		padding-block: 2rem 3rem;
	}
	.project-hero > * { min-width: 0; }
	h1 {
		font-size: clamp(var(--sl-text-4xl), 5vw, var(--sl-text-6xl));
		line-height: 1.1;
		font-weight: 600;
		color: var(--sl-color-white);
	}
	.tagline {
		margin-top: 1.5rem;
		font-size: var(--sl-text-lg);
		color: var(--sl-color-gray-2);
	}
	.actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 1rem 1.5rem;
		margin-top: 2rem;
	}
	.hero-preview {
		display: block;
		padding: 1rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.75rem;
		background: var(--sl-color-gray-6);
		text-decoration: none;
		color: var(--sl-color-text-accent);
	}
	.hero-preview img { width: 100%; height: auto; }
	.hero-preview > span { display: block; margin-top: 1rem; font-size: var(--sl-text-sm); }
	@media (min-width: 50rem) {
		.project-hero { grid-template-columns: 1fr 1fr; gap: 3rem; padding-block: 3rem 4rem; }
	}
</style>
